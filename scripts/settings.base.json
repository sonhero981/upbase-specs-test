{
  "_comment": "Nền của .claude/settings.json. scripts/setup.py thay {{PYTHON}} bằng lệnh python chạy được trên máy, rồi chèn permissions.additionalDirectories từ repos: trong workspace.yaml. Không sửa .claude/settings.json trực tiếp, sửa file này.",
  "permissions": {
    "allow": [
      "Bash({{PYTHON}} engine/scripts/po-tools.py *)",
      "Bash({{PYTHON}} engine/tech/scripts/tech-tools.py *)",
      "Bash({{PYTHON}} scripts/setup.py *)",
      "Bash({{PYTHON}} scripts/doctor.py *)"
    ],
    "deny": [
      "Edit(intents/*/archive/**)",
      "Write(intents/*/archive/**)",
      "Edit(.po/**)",
      "Write(.po/**)",
      "Edit(intents/*/reviews/*.digest)",
      "Write(intents/*/reviews/*.digest)",
      "Edit(engine/tech/aidlc/**)",
      "Write(engine/tech/aidlc/**)",
      "Edit(.claude/settings.json)",
      "Write(.claude/settings.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/engine/scripts/po-tools.py\" status"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/engine/scripts/po-hook.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/engine/scripts/po-hook.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON}} \"$CLAUDE_PROJECT_DIR/engine/scripts/po-hook.py\""
          }
        ]
      }
    ]
  }
}
